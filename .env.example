# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                      # Vacío para desarrollo (solo local)
DB_NAME=uajs_smart_campus

# ============================================
# AUTENTICACION
# ============================================
# Obligatorio: el gateway y el auth-service se niegan a arrancar sin él.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_96_hex
JWT_EXPIRES=24h

# ============================================
# PUERTOS DE LOS SERVICIOS
# ============================================
GATEWAY_PORT=3000                 # API Gateway
AUTH_SERVICE_PORT=3001            # Autenticación
USERS_SERVICE_PORT=3002           # Usuarios
EVENTS_SERVICE_PORT=3003          # Eventos
RESERVATIONS_SERVICE_PORT=3004    # Reservas
NOTIFICATIONS_SERVICE_PORT=3005   # Notificaciones
REQUESTS_SERVICE_PORT=3006        # Solicitudes
RESOURCES_SERVICE_PORT=3007       # Recursos
PQRS_SERVICE_PORT=3008            # PQRS
INFO_ACADEMICA_SERVICE_PORT=3009  # Información Académica
CONFIGURACION_SERVICE_PORT=3010   # Configuración
SEARCH_SERVICE_PORT=3011          # Búsqueda (Elasticsearch)

# ============================================
# BÚSQUEDA
# ============================================
# Reindexado automático de Elasticsearch. 0 o vacío = desactivado.
# P. ej. 300000 reindexa cada 5 minutos (evita reindexar a mano).
SEARCH_REINDEX_INTERVAL_MS=0

